# ============================================================
# Icebreaker Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env

# ------------------------------------------------------------
# REQUIRED — 3 variables to get started
# ------------------------------------------------------------

# Microsoft App ID from your Azure AD App Registration
# → Azure Portal > App Registrations > your app > Overview
MICROSOFT_APP_ID=your-microsoft-app-id-here

# Client secret for the App Registration
# → Azure Portal > App Registrations > your app > Certificates & Secrets
MICROSOFT_APP_PASSWORD=your-client-secret-here

# Public HTTPS URL where Teams can reach this bot
# Local dev:  run `ngrok http 3978` first, then paste the Forwarding URL here
# Production: your Azure Web App URL, e.g. https://my-bot.azurewebsites.net
CALLBACK_BASE_URL=https://your-bot-domain.example.com

# ------------------------------------------------------------
# OPTIONAL — AI-generated responses (highly recommended)
# Without an AI key the bot falls back to built-in scripted text.
#
# Option A: Azure OpenAI  (set all three AZURE_OPENAI_* vars)
# Option B: OpenAI        (set OPENAI_API_KEY only)
# ------------------------------------------------------------

# --- Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Standard OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# OPTIONAL — Icebreaker behaviour
# ------------------------------------------------------------

# Force a specific activity (leave blank for random each session)
# Values: two_truths_and_a_lie | would_you_rather | fun_fact_round | speed_intro
# DEFAULT_ACTIVITY=

# HTTP port (default: 3978)
# PORT=3978

# Log level: error | warn | info | debug  (default: info)
# LOG_LEVEL=info
