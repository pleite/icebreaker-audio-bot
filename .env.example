# ============================================================
# Icebreaker Audio Bot — Environment Variables
# ============================================================
# Copy this file to .env and fill in every value before running.
#
#   cp .env.example .env

# ------------------------------------------------------------
# Bot Framework (Azure Bot Service)
# ------------------------------------------------------------
# Application (client) ID of your Azure AD App Registration.
# Found in: Azure Portal → App Registrations → Overview
MICROSOFT_APP_ID=your-microsoft-app-id-here

# Client secret for the App Registration.
# Found in: Azure Portal → App Registrations → Certificates & Secrets
MICROSOFT_APP_PASSWORD=your-microsoft-app-password-here

# ------------------------------------------------------------
# Azure Communication Services (ACS)
# ------------------------------------------------------------
# Full connection string for your ACS resource.
# Found in: Azure Portal → Communication Services → Keys
ACS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=xxxx

# ------------------------------------------------------------
# Public callback URL
# ------------------------------------------------------------
# The base URL where this bot is reachable from the internet.
# ACS sends call-state events to <CALLBACK_BASE_URL>/api/callbacks
# Teams sends messages to    <CALLBACK_BASE_URL>/api/messages
#
# Local development: use ngrok → https://ngrok.com/download
#   ngrok http 3978
#   then set this to the generated HTTPS forwarding URL, e.g.:
#   CALLBACK_BASE_URL=https://abc123.ngrok-free.app
#
# Production: set to your Azure Web App or Container App URL
CALLBACK_BASE_URL=https://your-bot-domain.example.com

# ------------------------------------------------------------
# Azure Cognitive Services
# ------------------------------------------------------------
# Endpoint URL for your Azure AI Services (multi-service) resource.
# Used by ACS to perform TTS and STT inside the call.
# Found in: Azure Portal → Cognitive Services → Keys and Endpoint
COGNITIVE_SERVICES_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# ------------------------------------------------------------
# Optional tunables
# ------------------------------------------------------------
# HTTP port the server listens on (default: 3978)
# PORT=3978

# Default icebreaker activity. Leave blank for random each call.
# Options: two_truths_and_a_lie | would_you_rather | fun_fact_round | speed_intro
# DEFAULT_ACTIVITY=

# Azure Neural voice name for the bot (default: en-US-JennyNeural)
# Full list: https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support
# BOT_VOICE=en-US-JennyNeural

# Milliseconds of trailing silence before bot considers a response finished (default: 4000)
# RECOGNIZE_SILENCE_TIMEOUT_MS=4000

# Milliseconds to wait for participant to start speaking before timing out (default: 30000)
# RECOGNIZE_INITIAL_SILENCE_TIMEOUT_MS=30000

# Log level: error | warn | info | debug  (default: info)
# LOG_LEVEL=info
