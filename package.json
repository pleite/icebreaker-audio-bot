{
  "name": "icebreaker-audio-bot",
  "version": "1.0.0",
  "description": "A Microsoft Teams chat agent that conducts AI-powered icebreaker activities in meeting chats",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit",
    "setup": "node scripts/setup.js"
  },
  "keywords": [
    "teams",
    "bot",
    "icebreaker",
    "chat",
    "azure",
    "openai",
    "copilot"
  ],
  "license": "MIT",
  "dependencies": {
    "botbuilder": "^4.22.3",
    "dotenv": "^16.4.5",
    "openai": "^4.57.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
